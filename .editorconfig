root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,kts}]
indent_size = 4
max_line_length = 160

[*.{yml,yaml,json,md}]
indent_size = 2
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

[*.properties]
charset = utf-8
end_of_line = lf

[*.{png,jpg,jpeg,gif,ico,webp,jar,gz,zip,exe,dll}]
insert_final_newline = false
